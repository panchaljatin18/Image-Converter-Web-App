# ── Node dependencies ─────────────────────────────────────────────────────────
node_modules/
npm-debug.log
yarn-error.log

# ── Runtime directories (created at container startup) ────────────────────────
src/uploads/
src/downloads/
src/scripts/

# ── Environment files (secrets must NOT be baked into the image) ──────────────
.env
.env.local
.env.development
.env.production
.env*.local
!.env.example

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Git ──────────────────────────────────────────────────────────────────────
.git/
.gitignore

# ── Editor & OS files ─────────────────────────────────────────────────────────
.vscode/
.idea/
*.DS_Store
Thumbs.db

# ── Test files ────────────────────────────────────────────────────────────────
test.js
*.test.js
*.spec.js
__tests__/
coverage/

# ── Documentation & Workspace artifacts ───────────────────────────────────────
README.md
*.md
diff.txt
panel_segment.txt
redesign_backup.jsx
redesign_backup_utf8.jsx
replace_colors.js
docker-compose.yml
